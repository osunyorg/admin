<% if person.user_id.blank? && person.email.blank? %>
  <div class="mb-4">
    <% if Communication::Extranet::Invitation.sendable_to?(person) %>
      <p><%= t('extranet.alumni.invitations.send.label') %></p>
      <%= link_to t('extranet.alumni.invitations.send.cta', name: l10n.first_name), 
                  alumni_new_invitation_path(person), 
                  class: 'btn btn-primary btn-sm position-relative z-2' %>
    <% elsif person.extranet_invitations.latest.first.user_id == current_user.id %>
      <%= t('extranet.alumni.invitations.send.too_soon_same_user') %>
    <% else %>
      <%= t('extranet.alumni.invitations.send.too_soon_different_user') %>
    <% end %>
  </div>
<% end %>