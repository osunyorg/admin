<%
hide_diploma ||= false
hide_parent ||= false
%>
<div class="row g-2 mb-3">
  <% programs.each do |program| %>
    <div>
      <%
      partial = program.deleted?  ? 'admin/education/programs/program_deleted'
                                  : 'admin/education/programs/program'
      %>
      <%= render  partial,
                  program: program,
                  hide_diploma: hide_diploma,
                  hide_parent: hide_parent %>
    </div>
  <% end %>
</div>
