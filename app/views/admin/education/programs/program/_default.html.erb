<%
hide_diploma ||= false
%>
<div class="<%= osuny_card_classes(horizontal: true) %>">
  <%= osuny_thumbnail_localized program %>
  <div class="card-body d-flex align-items-center">
    <div class="me-2">
      <%= osuny_published_localized program %>
    </div>
    <div>
      <%= osuny_link_localized program, [:admin, program], classes: 'stretched-link' %>
      <% if program.parent.present? %>
        <br>
        <span class="small text-muted">
          <%= program.parent.best_localization_for(current_language) %>
        </span>
      <% end %>
    </div>
  </div>
  <% if !hide_diploma && program.diploma.present? %>
    <div class="card-footer small text-muted">
      <%= program.diploma.best_localization_for(current_language).short_name %>
    </div>
  <% end %>
</div>