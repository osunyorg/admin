<div class="row g-2 mb-3">
  <% papers.each do |paper| %>
    <div>
      <%
      partial = paper.deleted?  ? 'admin/research/journals/papers/paper_deleted'
                                : 'admin/research/journals/papers/paper'
      %>
      <%= render partial, paper: paper %>
    </div>
  <% end %>
</div>
