<% content_for :title, t('communication.description.parts.file.title') %>

<% content_for :title_right do %>
  <%= create_link Communication::File %>
<% end %>

<div class="d-flex justify-content-between mb-5">
  <%= render 'admin/application/components/lifecycle/pills',
              path_method: :admin_communication_files_path %>
  <%= render 'filters', current_path: admin_communication_files_path %>
</div>
<%= render 'admin/application/components/lifecycle/label' %>

<%= render 'admin/communication/library/files/list', files: @files %>
<%= paginate @files %>
