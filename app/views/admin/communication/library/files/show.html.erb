<% content_for :title, @l10n %>

<% content_for :title_right do %>
  <%= button_advanced do %>
    <%= destroy_link @file if @file.contexts.none? %>
  <% end %>
  <%= edit_link @file %>
<% end %>

<% if @l10n.draft? %>
  <div class="mb-3">
    <%= render 'admin/application/property/publication', about: @l10n %>
  </div>
<% end %>

<div class="row">
  <div class="col-lg-8">
    <div class="row">
      <div class="col-lg-3">
        <div class="osuny__file__icon">
          <i class="<%= @l10n.icon %>" title="<%= @l10n.original_content_type %>"></i>
        </div>
        <%= link_to t('download'),
              download_medium_path(signed_id: @l10n.original_blob.signed_id),
              class: button_classes %>
      </div>
      <div class="col-lg-9">
        <div class="row">
          <div class="col-lg-6">
            <%= osuny_label Communication::File::Localization.human_attribute_name(:original_filename) %>
            <p><%= @l10n.original_filename %></p>
            <% if @l10n.meta_description.present? %>
              <%= osuny_label t('admin.meta_description.label') %>
              <p><%= @l10n.meta_description %></p>
            <% end %>
          </div>
          <div class="col-lg-6">
            <%= osuny_label Communication::File::Localization.human_attribute_name(:original_byte_size) %>
            <p><%= number_to_human_size @l10n.original_byte_size %></p>
            <%= osuny_label Communication::File::Localization.human_attribute_name(:original_content_type) %>
            <p><%= @l10n.human_content_type %></p>
            <% if @file.created_by.present? %>
              <%= osuny_label Communication::File.human_attribute_name(:created_by) %>
              <p><%= @file.created_by %></p>
            <% end %>
            <% if @l10n.updated_by.present? %>
              <%= osuny_label Communication::File::Localization.human_attribute_name(:updated_by) %>
              <p><%= @l10n.updated_by %></p>
            <% end %>
            <% if @l10n.published_at.present? %>
              <%= osuny_label Communication::File::Localization.human_attribute_name(:published_at) %>
              <p><%= l(@l10n.published_at, format: :long).humanize %></p>
            <% end %>
          </div>
        </div>
        <% if @l10n.internal_description.present? %>
          <%= osuny_label Communication::File::Localization.human_attribute_name(:internal_description) %>
          <p><%= @l10n.internal_description %></p>
        <% end %>
        <div class="mt-5">
          <%= render 'admin/application/categories/widget/show', about: @file %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <%= render 'admin/application/images/featured/show', about: @l10n %>
  </div>
</div>

<%= render 'admin/application/l10n/widget', about: @file, l10n: @l10n %>  

<%= render 'admin/communication/library/contexts/list', contexts: @contexts %>

<% content_for :server_admin_only do %>
  <%= static_link static_admin_communication_file_path(@file) %>
<% end %>
