<%
# Données
current = {
  featured_media_id: about.featured_media_id.to_s,
  featured_media_alt: about.featured_media_alt.to_s
}

# Endpoints
default_settings = {
  website_id: nil,
  extranet_id: nil,
  journal_id: nil
}
upload_endpoint = direct_upload_admin_communication_medias_path(**default_settings)
cloud_unsplash_endpoint = unsplash_admin_communication_medias_path(**default_settings)
cloud_pexels_endpoint = pexels_admin_communication_medias_path(**default_settings)
cloud_select_endpoint = cloud_select_admin_communication_medias_path(**default_settings)
picker_endpoint = picker_admin_communication_medias_path(**default_settings, format: :json)
object_endpoint = admin_communication_medias_path(**default_settings)
changes_endpoint = set_featured_admin_communication_medias_path(
  **default_settings,
  about_id: about.id, 
  about_type: about.class.polymorphic_name
)
%>
<div
  id="featured-media-app"
  data-current="<%= current.to_json %>"
  data-upload-endpoint="<%= upload_endpoint %>"
  data-upload-hint="<%= images_formats_accepted_hint %>"
  data-cloud-query="<%= about.to_s %>"
  data-cloud-unsplash-endpoint="<%= cloud_unsplash_endpoint %>"
  data-cloud-pexels-endpoint="<%= cloud_pexels_endpoint %>"
  data-cloud-select-endpoint="<%= cloud_select_endpoint %>"
  data-picker-endpoint="<%= picker_endpoint %>"
  data-object-endpoint="<%= object_endpoint %>"
  data-changes-endpoint="<%= changes_endpoint %>"
  data-size-limit="<%= Rails.application.config.default_image_max_size %>"
  data-formats-accepted="<%= default_images_formats_accepted %>"
  >
</div>
