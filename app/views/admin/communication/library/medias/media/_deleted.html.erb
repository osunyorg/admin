<%
l10n = media.best_localization_for(current_language)
initials = l10n.initials
image = media.deleted_original_blob
%>
<div class="<%= osuny_card_classes %>">
  <div class="osuny__thumbnail
              osuny__thumbnail--large
              osuny__thumbnail--cropped">
    <% if image.variable? %>
      <%= kamifusen_tag image,
                        width: 600,
                        height: 600,
                        crop: true,
                        quality: 50,
                        class: 'img-fluid' %>
    <% else %>
      <span class="osuny__thumbnail__initials">
        <%= initials %>
      </span>
    <% end %>
  </div>
  <div class="card-body">
    <p class="small mb-0"><%= media.best_localization_for(current_language) %></p>
  </div>
  <% if can?(:restore, media) %>
    <div class="card-footer mb-n2">
      <%= link_to t('restore'),
                  restore_admin_communication_media_path(media),
                  method: :post,
                  class: button_classes %>
    </div>
  <% end %>
</div>
