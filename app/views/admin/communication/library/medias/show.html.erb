<% content_for :title, @l10n %>

<% content_for :title_right do %>
  <%= button_advanced do %>
    <%= destroy_link @media if @media.contexts.none? %>
  <% end %>
  <%= edit_link @media %>
<% end %>

<% if @l10n.draft? %>
  <div class="mb-3">
    <%= render 'admin/application/property/publication', about: @l10n %>
  </div>
<% end %>

<div class="row mb-5">
  <div class="col-lg-4">
    <%= kamifusen_tag @media.original_blob, class: 'img-fluid mb-3' %>
    <%= link_to t('download'),
              download_medium_path(signed_id: @media.original_blob.signed_id),
              class: button_classes %>
  </div>
  <div class="col-lg-8">
    <div class="row">
      <div class="col-lg-6">
        <%= osuny_label Communication::Media.human_attribute_name(:original_filename) %>
        <p><%= @media.original_filename %></p>
        <% if @l10n.alt.present? %>
          <%= osuny_label t('admin.communication.media.alt.label') %>
          <p><%= @l10n.alt %></p>
        <% end %>
        <% if @l10n.credit.present? %>
          <%= osuny_label t('admin.communication.media.credit.label') %>
          <div><%= sanitize @l10n.credit %></div>
        <% end %>
        <% if @l10n.internal_description.present? %>
          <%= osuny_label Communication::Media::Localization.human_attribute_name(:internal_description) %>
          <p><%= @l10n.internal_description %></p>
        <% end %>
        <%= render 'admin/application/categories/widget/show', about: @media %>
      </div>
      <div class="col-lg-6">
        <div class="row">
          <div class="col-6">
            <%= osuny_label Communication::Media.human_attribute_name(:original_content_type) %>
            <p><%= @media.original_content_type %></p>
          </div>
          <div class="col-6">
            <%= osuny_label Communication::Media.human_attribute_name(:original_byte_size) %>
            <p><%= number_to_human_size @media.original_byte_size %></p>
          </div>
          <div class="col-6">
            <%= osuny_label Communication::Media.human_attribute_name(:width) %>
            <p><%= @media.width %>px</p>
          </div>
          <div class="col-6">
            <%= osuny_label Communication::Media.human_attribute_name(:height) %>
            <p><%= @media.height %>px</p>
          </div>
        </div>
        <%= osuny_label Communication::Media.human_attribute_name(:origin) %>
        <p><%= @media.origin_i18n %></p>
        <% if @media.created_by.present? %>
          <%= osuny_label Communication::Media.human_attribute_name(:created_by) %>
          <p><%= @media.created_by %></p>
        <% end %>
        <% if @l10n.updated_by.present? %>
          <%= osuny_label Communication::Media::Localization.human_attribute_name(:updated_by) %>
          <p><%= @l10n.updated_by %></p>
        <% end %>
        <% if @l10n.published_at.present? %>
          <%= osuny_label Communication::Media::Localization.human_attribute_name(:published_at) %>
          <p><%= l(@l10n.published_at, format: :long).humanize %></p>
        <% end %>
      </div>
    </div>
  
    <% if @media.collection.present? %>
      <%= osuny_label Communication::Media::Localization.human_attribute_name(:collection) %>
      <p><%= osuny_link_localized @media.collection, admin_communication_media_collection_path(@media.collection) %><p>
    <% end %>
  </div>
</div>

<%= render 'admin/application/l10n/widget', about: @media, l10n: @l10n %>

<%= render 'admin/communication/library/contexts/list', contexts: @contexts %>
