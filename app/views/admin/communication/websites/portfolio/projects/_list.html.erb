<% if projects.none? %>
  <p><%= t('admin.communication.website.portfolio.projects.none') %></p>
<% else %>
  <div class="row g-2 mb-2">
    <% projects.each do |project| %>
      <div>
        <%
        partial = project.deleted?  ? 'admin/communication/websites/portfolio/projects/project_deleted'
                                    : 'admin/communication/websites/portfolio/projects/project'
        %>
        <%= render  partial, project: project %>
      </div>
    <% end %>
  </div>
<% end %>