<% if projects.none? %>
  <p><%= t('admin.communication.website.portfolio.projects.none') %></p>
<% else %>
  <div class="row g-2 mb-2">
    <% projects.each do |project| %>
      <div>
        <%= render 'admin/communication/websites/portfolio/projects/project',
                    project: project %>
      </div>
    <% end %>
  </div>
<% end %>