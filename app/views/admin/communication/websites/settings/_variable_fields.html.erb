<% name = "communication_website[kelmscott_variables][#{variable.key}]"
   id = "communication_website_kelmscott_variables_#{variable.key.downcase}"
   secret_saved = variable.persisted? && variable.secret? %>
<div class="mb-3">
  <%= label_tag id, variable.key, class: 'form-label' %>
  <% if variable.secret? && variable.multiline? %>
    <%# Un secret enregistré est chiffré : il n'est jamais renvoyé, le champ reste vide %>
    <%= text_area_tag name, '', id: id, rows: 5, autocomplete: 'off', class: 'form-control', style: '-webkit-text-security: disc' %>
  <% elsif variable.secret? %>
    <%= password_field_tag name, '', id: id, autocomplete: 'new-password', class: 'form-control' %>
  <% else %>
    <%= text_field_tag name, variable.value, id: id, autocomplete: 'off', class: 'form-control' %>
  <% end %>
  <% if variable.errors[:value].any? %>
    <div class="invalid-feedback d-block"><%= variable.errors[:value].to_sentence %></div>
  <% end %>
  <% if secret_saved %>
    <div class="form-text"><%= t('communication.website.kelmscott.masked') %></div>
  <% end %>
</div>
