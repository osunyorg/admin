<% if website.repository.present? %>
  <ul class="list-unstyled list-inline">
    <% if website.status_badge? %>
      <li class="list-inline-item">
        <%= image_tag website.status_badge_url, alt: '' %>
      </li>
    <% end %>
    <% if website.kelmscott_active? %>
      <% if can?(:kelmscott_publish, website) %>
        <li class="list-inline-item">
          <%= link_to t('admin.communication.website.kelmscott_publish.button'),
                      kelmscott_publish_admin_communication_website_path(website),
                      method: :post,
                      class: 'action'  %>
        </li>
      <% end %>
      <li class="list-inline-item">
        <%= link_to t('admin.communication.website.kelmscott_publish.show_logs'),
                    website.kelmscott_url,
                    target: :_blank,
                    class: 'action' %>
      </li>
    <% end %>
    <li class="list-inline-item">
      <%= link_to t('admin.communication.website.show_repository'),
                  website.repository_url,
                  target: :_blank,
                  class: 'action' %>
    </li>
  </ul>
<% end %>