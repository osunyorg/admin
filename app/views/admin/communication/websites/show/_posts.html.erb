<%= osuny_panel @website.feature_posts_name(current_language) do %>
  <div class="row g-2 mb-3">
    <% @posts.each do |post| %>
      <div>
        <%= render 'admin/communication/websites/posts/post_small', post: post %>
      </div>
    <% end %>
    <%= render 'admin/application/components/all',
                link: admin_communication_website_posts_path(website_id: @website) %>
  </div>
<% end %>
