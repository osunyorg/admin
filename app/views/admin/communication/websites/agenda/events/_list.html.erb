<%
selectable ||= false
%>
<% if events.none? %>
  <p><%= t('admin.communication.website.agenda.events.none') %></p>
<% else %>
  <% if selectable %>
    <input type="hidden" name="ids[]" value="">
    <input type="checkbox" class="form-check-input" data-batch-selectable-role="select-all">
  <% end %>
  <div class="row g-2 mb-3">
    <% events.each do |event| %>
      <div class="d-flex">
        <% if selectable %>
          <div class="pe-2">
            <%= check_box_tag "ids[]",
                              event.id,
                              false,
                              class: 'form-check-input',
                              data: { batch_selectable_role: "select-single" } %>
          </div>
        <% end %>
        <%
        partial = 'admin/communication/websites/agenda/events/event'
        if event.deleted?
          partial = 'admin/communication/websites/agenda/events/event_deleted'
        elsif event.is_template?
          partial = 'admin/communication/websites/agenda/events/event_template'
        end
        %>
        <%= render partial, event: event %>
      </div>
    <% end %>
  </div>
<% end %>
