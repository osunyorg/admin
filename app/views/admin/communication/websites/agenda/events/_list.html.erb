<%
selectable ||= false
%>
<% if events.none? %>
  <p><%= t('admin.communication.website.agenda.events.none') %></p>
<% else %>
  <% if selectable %>
    <input type="hidden" name="ids[]" value="">
    <%= check_box_tag nil,
                      nil,
                      false,
                      class: 'form-check-input',
                      data: { batch_selectable_role: "select-all" } %>
  <% end %>
  <div class="row g-2 mb-3">
    <% events.each do |event| %>
      <div class="d-flex">
        <% if selectable %>
          <div class="pe-2">
            <%= check_box_tag "ids[]",
                              event.id,
                              false,
                              class: 'form-check-input',
                              data: { batch_selectable_role: "select-single" } %>
          </div>
        <% end %>
        <%
        partial = event.deleted?  ? 'admin/communication/websites/agenda/events/event_deleted'
                                  : 'admin/communication/websites/agenda/events/event'
        %>
        <%= render  partial,
                    event: event %>
      </div>
    <% end %>
  </div>
<% end %>
