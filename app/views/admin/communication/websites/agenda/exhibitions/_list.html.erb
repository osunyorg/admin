<% if exhibitions.none? %>
  <p><%= t('admin.communication.website.agenda.exhibitions.none') %></p>
<% else %>
  <div class="row g-2 mb-3">
    <% exhibitions.each do |exhibition| %>
      <div>
        <%= render 'admin/communication/websites/agenda/exhibitions/exhibition',
                    exhibition: exhibition %>  
      </div>
    <% end %>
  </div>
<% end %>