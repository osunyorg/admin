<% if @website && @website.synchronization_locked? %>
  <div class="container-fluid text-center mb-5">
    <%= lucide_icon('lock') %>
    <span class="small ms-2">
      <% if @website.synchronization_locked_by.server_admin? %>
        <%= t('admin.communication.website.synchronization.locked_for_maintenance') %>
      <% else %>
        <%= t('admin.communication.website.synchronization.locked_by', user: @website.synchronization_locked_by) %>
      <% end %>
    </span>
  </div>
<% end %>
