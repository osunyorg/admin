<% if jobs.none? %>
  <p><%= t('admin.communication.website.jobboard.jobs.none') %></p>
<% else %>
  <div class="row g-2 mb-3">
    <% jobs.each do |job| %>
      <div>
        <%= render 'admin/communication/websites/jobboard/jobs/job',
                    job: job %>
      </div>
    <% end %>
  </div>
<% end %>