<% if jobs.none? %>
  <p><%= t('admin.communication.website.jobboard.jobs.none') %></p>
<% else %>
  <div class="row g-2 mb-3">
    <% jobs.each do |job| %>
      <div>
        <%
        partial = job.deleted?  ? 'admin/communication/websites/jobboard/jobs/job_deleted'
                                : 'admin/communication/websites/jobboard/jobs/job'
        %>
        <%= render partial, job: job %>
      </div>
    <% end %>
  </div>
<% end %>