<div class="<%= osuny_card_classes(horizontal: true) %>">
  <%= osuny_thumbnail_localized post %>
  <div class="card-body">
    <%= post.best_localization_for(current_language) %>
  </div>
  <% if can?(:restore, post) %>
    <div class="card-footer mb-n2">
      <%= link_to t('restore'),
                  restore_admin_communication_website_post_path(post),
                  method: :post,
                  class: button_classes %>
    </div>
  <% end %>
</div>