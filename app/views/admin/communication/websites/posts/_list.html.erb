<%
hide_badges ||= false
selectable ||= false
%>
<% if posts.none? %>
  <p><%= t('communication.website.posts.none') %></p>
<% else %>
  <% if selectable %>
    <input type="hidden" name="ids[]" value="">
  <% end %>
  <div class="table-responsive <%= 'table-selectable' if selectable %>">
    <table class="table table-borderless table-sm <%= 'mt-n4' if selectable %>">
      <% if selectable %>
        <thead>
          <tr>
            <th class="border-0">
              <%= check_box_tag nil,
                                nil,
                                false,
                                class: 'form-check-input',
                                data: { batch_selectable_role: "select-all" } if selectable %>
            </th>
          </tr>
        </thead>
      <% end %>
      <tbody>
        <% posts.each do |post| %>
          <tr>
            <% if selectable %>
              <td class="border-0">
                <%= check_box_tag "ids[]",
                                  post.id,
                                  false,
                                  class: 'form-check-input',
                                  data: { batch_selectable_role: "select-single" } %>
              </td>
            <% end %>
            <td>
              <%
              partial = post.deleted? ? 'admin/communication/websites/posts/post_deleted'
                                      : 'admin/communication/websites/posts/post'
              %>
              <%= render  partial,
                          post: post,
                          hide_badges: hide_badges,
                          website: website %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>