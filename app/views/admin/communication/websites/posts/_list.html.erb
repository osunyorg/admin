<%
small ||= false
hide_badges ||= false
selectable ||= false
if small
  hide_badges = true
end
link_to_all ||= false
%>
<% if posts.none? %>
  <p><%= t('communication.website.posts.none') %></p>
<% else %>
  <% if selectable %>
    <input type="hidden" name="ids[]" value="">
  <% end %>
  <div class="table-responsive <%= 'table-selectable' if selectable %>">
    <table class="table table-borderless table-sm">
      <thead>
        <tr>
          <% if selectable %>
            <th class="border-0">
              <%= check_box_tag nil,
                                nil,
                                false,
                                class: 'form-check-input',
                                data: { batch_selectable_role: "select-all" } if selectable %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% posts.each do |post| %>
          <tr>
            <% if selectable %>
              <td class="border-0">
                <%= check_box_tag "ids[]",
                                  post.id,
                                  false,
                                  class: 'form-check-input',
                                  data: { batch_selectable_role: "select-single" } %>
              </td>
            <% end %>
            <td>
              <%
              partial = post.deleted? ? 'admin/communication/websites/posts/post_deleted'
                                      : 'admin/communication/websites/posts/post'
              %>
              <%= render  partial,
                          post: post,
                          small: small,
                          hide_badges: hide_badges,
                          website: website %>
            </td>
          </tr>
        <% end %>
        <% if link_to_all %>
          <tr>
            <td>
              <%= render 'admin/application/components/all',
                          link: admin_communication_website_posts_path(website_id: @website) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>