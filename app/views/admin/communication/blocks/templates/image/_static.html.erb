<%
component = block.template.image_component
media = component.communication_media
media_l10n = component.communication_media_localization
blob = component.blob
%>
<%= osuny_static_text :text,
                      block.template.text,
                      depth: 4 %>
      image:
        id: "<%= blob.id %>"
<%= osuny_static_text :alt,
                      block.template.alt,
                      depth: 5 %>
<%= osuny_static_text :credit,
                      media_l10n.credit,
                      depth: 5 %>