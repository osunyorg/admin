<%
component = block.template.image_component
media_l10n = component.communication_media_localization
blob = component.blob
credit = strip_tags media_l10n&.credit
%>
<% if blob.present? %>
  <%= kamifusen_tag blob,
                    width: 1024,
                    alt: block.template.alt,
                    class: 'img-fluid mb-2' %>
  <%= block_component_snippet block, :text %>
  <% if credit.present? %>
    <div class="small text-muted">
      © <%= credit %>
    </div>
  <% end %>
<% end %>