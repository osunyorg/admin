<div class="grid projects projects--grid">
  <% block.template.selected_projects.each do |project|
      next if project.nil?
      project_l10n = project.localization_for(block.language)
      %>
    <article class="project" itemscope itemtype="https://schema.org/CreativeWork">
      <div class="project-content">
        <div class="project-description">
          <h<%= block.heading_rank_children %> class='project-title' itemprop='name'>
            <%= link_to project_l10n, project_l10n.current_permalink_url_in_website(@website) %>
          </h<%= block.heading_rank_children %>>
          <%= render 'admin/communication/blocks/templates/projects/partials/summary',
                      block: block,
                      project: project,
                      project_l10n: project_l10n %>
          <%= render 'admin/communication/blocks/templates/projects/partials/categories',
                      block: block,
                      project: project,
                      project_l10n: project_l10n %>
        </div>
      </div>
      <div class="media">
        <% if project_l10n.featured_blob.present? %>
          <%= kamifusen_tag project_l10n.featured_blob %>
        <% end %>
      </div>
    </article>
  <% end %>
</div>