<%
component = block.template.image_component
media_l10n = component.communication_media_localization
blob = component.blob
%>
      layout: <%= block.template.layout %>
<%= block_component_static block, :text %>
<%= block_component_static block, :notes %>
<% if blob %>
<%= block_component_static block, :image %>
<%= osuny_static_text :alt, block.template.alt, depth: 5 %>
<%= osuny_static_html :credit, media_l10n&.credit, depth: 5 %>
<% end %>
