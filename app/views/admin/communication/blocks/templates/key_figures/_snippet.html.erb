<%= block_component_snippet block, :description %>
<% block.template.elements.each do |element| %>
  <div class="row mb-3">
    <% if element.image_component.blob.present? %>
      <div class="col-2">
        <%= block_component_snippet block, :image, template: element %>
      </div>
    <% end %>
    <div class="col-10">
      <div class="lead">
        <%= block_component_snippet block, :number, template: element %>
        <%= block_component_snippet block, :unit, template: element %>
      </div>
      <%= block_component_snippet block, :description, template: element %>
    </div>
  <% end %>
</div>