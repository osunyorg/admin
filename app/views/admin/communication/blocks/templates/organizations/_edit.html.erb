<%
picker_endpoint = picker_admin_university_organizations_path(format: :json)
object_endpoint = admin_university_organizations_path
%>
<%= block_component_edit block, :description, summernote_config: 'mini' %>
<%= block_component_edit block, :mode %>
<div v-if="data.mode === 'category'">
  <%= block_component_edit block, :category_id %>
</div>

<div v-if="data.mode === 'selection'">
  <div><%= osuny_label University::Organization.model_name.human(count: 2) %></div>

  <picker
    ref="picker"
    title="<%= University::Organization.model_name.human(count: 2) %>"
    endpoint="<%= picker_endpoint %>"
    @update:model-value="data.elements.push({id: $event.id})">
  </picker>

  <a
    class="<%= button_classes('me-2') %>"
    @click="$refs.picker.open()">
    <%= t('.add_organization') %>
  </a>
  <a
    class="<%= button_classes %>"
    @click="data.elements.push({})">
    <%= t('.add_organization_unregistered') %>
  </a>

  <div
    class="alert bg-warning text-white mb-4"
    v-if="data.layout === 'map' && data.mode === 'selection' && data.elements.filter(e => !e.id).length > 0">
    <%= t('admin.communication.blocks.templates.organizations.edit.unregistered_organizations_on_map_warning') %>
  </div>

  <draggable
    :list="data.elements"
    handle=".osuny__thumbnail"
    class="row g-2 mb-2">
    <div v-for="(element, index) in data.elements">
      <div
        v-if="element.id"
        class="d-flex align-items-center">
        <div class="row flex-fill align-items-center">
          <div class="col-sm-6">
            <selected-organization
              :id="element.id"
              endpoint="<%= object_endpoint %>"
              class="flex-fill">
            </selected-organization>
          </div>
          <div class="col-sm-6">
            <div class="mb-n3">
              <%= block_component_edit block, :role, template: @element, label: '' %>
            </div>
          </div>
        </div>
        <a class="btn btn-sm text-danger ps-0 ms-3"
          @click="deleteElement(element)"
          title="<%= t('delete') %>">
          <i class="<%= Icon::DELETE %>"></i>
        </a>
      </div>
      <div v-else>
        <div class="d-flex align-items-center">
          <div class="row flex-fill align-items-center">
            <div class="col-sm-6">
              <div class="card card--osuny card--horizontal flex-fill">
                <div class="osuny__thumbnail osuny__thumbnail--small">
                  <span class="osuny__thumbnail__initials">?</span>
                </div>
                <div class="card-body">{{element.name}}
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="mb-n3">
                <%= block_component_edit block, :role, template: @element, label: '' %>
              </div>
            </div>
          </div>
          <a class="btn btn-sm text-danger ps-0 ms-3"
            @click="deleteElement(element)"
            title="<%= t('delete') %>">
            <i class="<%= Icon::DELETE %>"></i>
          </a>
        </div>
        <div class="border-start ps-3 pt-2 mb-3 ">
          <%= block_component_edit block, :name, template: @element %>
          <%= block_component_edit block, :url, template: @element %>
          <%= block_component_edit block, :logo, template: @element %>
        </div>
      </div>
    </div>
  </draggable>
  <div v-show="data.elements.length > 2">
    <a
      class="<%= button_classes('me-2') %>"
      @click="$refs.picker.open()">
      <%= t('.add_organization') %>
    </a>
    <a
      class="<%= button_classes %>"
      @click="data.elements.push({})">
      <%= t('.add_organization_unregistered') %>
    </a>
  </div>
</div>

<%= osuny_separator %>
<%= osuny_small_panel t('admin.communication.blocks.components.layouts.label') do %>
  <%= block_component_edit block, :layout %>
  <%= osuny_label t('admin.communication.blocks.display_options.title') %>
  <div class="row">
    <div class="col-sm-6">
      <%= block_component_edit block, :option_logo %>
      <%= block_component_edit block, :option_link %>
    </div>
    <div class="col-sm-6">
      <%= block_component_edit block, :option_summary, label: t('admin.summary.label') %>
      <%= block_component_edit block, :option_address %>
      <div v-if="data.layout === 'map'">
        <%= block_component_edit block, :option_filters %>
      </div>
      <div v-if="data.mode === 'selection'">
        <%= block_component_edit block, :alphabetical %>
      </div>
    </div>
  </div>
<% end %>
