<p><%= t('admin.communication.blocks.templates.sound.edit.file.label')%></p>
<div class="d-flex align-items-center mb-3">
  <file-selector
    class="flex-fill"
    :model-value="data.file"
    @update:model-value="data.file = $event"
    upload-url="<%= direct_upload_admin_communication_files_path %>"
    picker-endpoint="<%= picker_admin_communication_files_path(format: :json) %>"
    object-endpoint="<%= admin_communication_files_path %>"
    label="<%= t('admin.communication.blocks.components.file.button') %>"
    title="<%= Communication::File.model_name.human(count: 2) %>"
    accept="<%= default_audio_formats_accepted %>"
    :size-limit="<%= Rails.application.config.default_file_max_size %>">
  </file-selector>
  <a
    class="btn btn-sm text-danger ms-3"
    v-if="data.file.communication_file_id"
    @click="data.file = {}"
    title="<%= t('delete') %>">
    <i class="<%= Icon::DELETE %>"></i>
  </a>
</div>
<%= block_component_edit block, :title %>
<%= block_component_edit block, :transcription,
      label: t('admin.communication.blocks.components.transcription.label'),
      placeholder: t('admin.communication.blocks.components.transcription.placeholder'), 
      summernote_config: 'link' %>
