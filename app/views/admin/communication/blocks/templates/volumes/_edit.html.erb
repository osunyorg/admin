<%
website = block.about.website
journal_id = website.about_id
picker_title = Research::Journal::Paper.model_name.human(count: 2)
picker_endpoint = picker_admin_research_journal_volumes_path(journal_id: journal_id, format: :json)
object_endpoint = admin_research_journal_volumes_path(journal_id: journal_id)
%>
<%= block_component_edit block, :mode %>

<div class="row">
  <div v-if="data.mode === 'all'" class="col-lg-3">
    <%= block_component_edit block, :quantity %>
  </div>
</div>

<div class="mb-4" v-if="data.mode == 'selection'">
  <h2 class="h4"><%= t '.selection.title' %></h2>

  <picker
    ref="picker"
    kind="volumes"
    title="<%= picker_title %>"
    endpoint="<%= picker_endpoint %>"
    :model-value="null"
    @update:model-value="data.elements.push({id: $event.id})">
  </picker>

  <a
    class="<%= button_classes %>"
    @click="$refs.picker.open()">
    <%= t('.selection.add') %>
  </a>

  <draggable
    :list="data.elements"
    handle=".osuny__thumbnail"
    class="row g-2 mb-2">
    <div
      v-for="(element, index) in data.elements"
      class="d-flex align-items-center">
      <selected-volume
        :id="element.id"
        endpoint="<%= object_endpoint %>"
        class="flex-fill">
      </selected-volume>
      <a  class="btn btn-sm text-danger ms-3"
          @click="deleteElement(element)"
          title="Supprimer">
          <i class="<%= Icon::DELETE %>"></i>
      </a>
    </div>
  </draggable>
</div>