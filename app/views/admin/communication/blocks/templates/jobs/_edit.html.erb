<%
website_id = block.about.communication_website_id
picker_endpoint = picker_admin_communication_website_jobboard_jobs_path(website_id: website_id, format: :json)
object_endpoint = admin_communication_website_jobboard_jobs_path(website_id: website_id)
%>
<%= block_component_edit block, :description, summernote_config: 'mini' %>

<%= block_component_edit block, :mode %>

<div class="row">
  <div class="col-sm-6 mb-3" v-show="data.mode != 'selection'">
    <%= block_component_edit block, :jobs_quantity %>
  </div>
  <div class="col-sm-6 mb-3" v-show="data.mode === 'category'">
    <%= block_component_edit block, :category_id %>
  </div>
</div>

<div
  v-show="data.mode === 'selection'"
  class="mb-5">
  <picker
    ref="picker"
    title="<%= Communication::Website::Jobboard::Job.model_name.human(count: 2) %>"
    endpoint="<%= picker_endpoint %>"
    @update:model-value="data.elements.push({id: $event.id})">
  </picker>
  <a
    class="<%= button_classes %>"
    @click="$refs.picker.open()">
    <%= t('.add_job') %>
  </a>
  <draggable
    :list="data.elements"
    handle=".osuny__thumbnail"
    class="row g-2 mb-2">
    <div
      v-for="(element, index) in data.elements"
      class="d-flex align-items-center">
      <selected-object
        :id="element.id"
        endpoint="<%= object_endpoint %>"
        class="flex-fill">
      </selected-object>
      <a
        class="btn btn-sm text-danger ms-3"
        @click="deleteElement(element)"
        title="<%= t('delete') %>">
        <i class="<%= Icon::DELETE %>"></i>
      </a>
    </div>
  </draggable>
  <div v-show="data.elements.length > 2">
    <a
      class="<%= button_classes %>"
      @click="$refs.picker.open()">
      <%= t('.add_job') %>
    </a>
  </div>
</div>
<%= block_component_edit block, :no_job_message %>

<%= osuny_separator %>
<%= osuny_small_panel t('admin.communication.blocks.components.layouts.label') do %>
  <%= block_component_edit block, :layout %>
  <%= osuny_label t('admin.communication.blocks.display_options.title') %>
  <div class="row">
    <div class="col-sm-6">
      <%= block_component_edit block, :option_image, label: Communication::Website::Jobboard::Job::Localization.human_attribute_name(:featured_image) %>
      <%= block_component_edit block, :option_subtitle, label: Communication::Website::Jobboard::Job::Localization.human_attribute_name(:subtitle) %>
      <%= block_component_edit block, :option_summary, label: t('admin.summary.label') %>
    </div>
    <div class="col-sm-6">
      <%= block_component_edit block, :option_dates, label: Communication::Website::Jobboard::Job.human_attribute_name(:dates) %>
      <%= block_component_edit block, :option_categories, label: Communication::Website::Jobboard::Job.human_attribute_name(:categories) %>
    </div>
  </div>
<% end %>
