<%
website_id = block.about.communication_website_id
picker_endpoint = picker_admin_communication_website_pages_path(website_id: website_id, format: :json)
object_endpoint = admin_communication_website_pages_path(website_id: website_id)
%>
<%= block_component_edit block, :mode %>

<div class="my-5" v-if="data.mode === 'category'">
  <%= block_component_edit block, :category_id %>
</div>

<div class="my-5" v-if="data.mode === 'selection'">
  <h2 class="h4"><%= t '.selection.title' %></h2>

  <picker
    ref="picker"
    kind="pages"
    title="<%= Communication::Website::Page.model_name.human(count: 2) %>"
    endpoint="<%= picker_endpoint %>"
    :model-value="null"
    @update:model-value="data.elements.push({id: $event.id})">
  </picker>

  <a
    class="<%= button_classes %>"
    @click="$refs.picker.open()">
    <%= t('.selection.add') %>
  </a>

  <draggable
    :list="data.elements"
    handle=".osuny__thumbnail"
    class="row g-2 mb-2">
    <div
      v-for="(element, index) in data.elements"
      class="d-flex align-items-center">
      <selected-page
        :id="element.id"
        endpoint="<%= object_endpoint %>"
        class="flex-fill">
      </selected-page>
      <a  class="btn btn-sm text-danger ms-3"
          @click="deleteElement(element)"
          title="<%= t('delete') %>">
          <i class="<%= Icon::DELETE %>"></i>
      </a>
    </div>
  </draggable>
  <div v-show="data.elements.length > 2">
    <a
      class="<%= button_classes('mb-4') %>"
      @click="$refs.picker.open()">
      <%= t('.selection.add') %>
    </a>
  </div>
</div>

<div class="my-5" v-if="data.mode !== 'category'">
  <h2 class="h4"><%= t '.main_page.title' %></h2>
  <div class="d-flex align-items-center">
    <page-selector
      :model-value="data.page_id"
      @update:model-value="data.page_id = $event"
      picker-endpoint="<%= picker_endpoint %>"
      object-endpoint="<%= object_endpoint %>"
      label="<%= t('admin.communication.blocks.components.page.button') %>"
      title="<%= Communication::Website::Page.model_name.human(count: 2) %>"
      class="flex-fill">
    </page-selector>
    <a
      class="btn btn-sm text-danger ms-3"
      v-if="data.page_id"
      @click="data.page_id = ''"
      title="<%= t('delete') %>">
      <i class="<%= Icon::DELETE %>"></i>
    </a>
  </div>
</div>

<%= osuny_separator %>
<%= osuny_small_panel t('admin.communication.blocks.components.layouts.label') do %>
  <%= block_component_edit block, :layout %>
  <%= osuny_label t('admin.communication.blocks.display_options.title') %>
  <%= block_component_edit block, :option_main_summary %>
  <%= block_component_edit block, :option_image %>
  <%= block_component_edit block, :option_subtitle %>
  <%= block_component_edit block, :option_summary %>
  <%= block_component_edit block, :option_categories %>
<% end %>