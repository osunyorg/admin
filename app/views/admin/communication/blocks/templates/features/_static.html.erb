<%= block_component_static block, :layout %>
<%= block_component_static block, :description %>
<%= block_options_static block %>
      elements:
<%
block.template.elements.each do |element|
  next if element.empty?
  component = element.image_component
  media_l10n = component.communication_media_localization
  blob = component.blob
  %>
        - 
<%= block_component_static block, :title, template: element, depth: 5 %>
<%= block_component_static block, :description, template: element, depth: 5 %>
<% if blob %>
<%= block_component_static block, :image, template: element, depth: 5 %>
<%= osuny_static_text :alt, element.alt, depth: 7 %>
<%= osuny_static_html :credit, media_l10n&.credit, depth: 7 %>
<%= osuny_static_text :alt, element.alt, depth: 6 %>
<%= osuny_static_html :credit, media_l10n&.credit, depth: 6 %>
<% end %>
<% end %>
