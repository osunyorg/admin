<div class="alternate <% unless block.template.option_image %> without-image<% end %>">
  <% 
  block.template.selected_posts.each_with_index do |post, index|
    next if post.nil?
    post_l10n = post.localization_for(block.language)
    permalink = post_l10n.current_permalink_url_in_website(@website)
    image_present = block.template.option_image && post_l10n.featured_blob
  %>
    <article class="post<% if !image_present %> without-image<% end %>" itemprop="blogPosts" itemscope itemtype="http://schema.org/BlogPosting">
      <div class="post-content">
        <%= render 'admin/communication/blocks/templates/posts/partials/heading', 
                    level: block.heading_rank_children,
                    label: post_l10n.to_s,
                    permalink: permalink %>
        <%= render 'admin/communication/blocks/templates/posts/partials/summary',
                    block: block,
                    post: post,
                    post_l10n: post_l10n %>
        <%= render 'admin/communication/blocks/templates/posts/partials/post_meta',
                    block: block,
                    post: post,
                    post_l10n: post_l10n %>
        <%= render 'admin/communication/blocks/templates/posts/partials/categories',
                    block: block,
                    post: post,
                    post_l10n: post_l10n %>
      </div>
      <% if image_present %>
        <div class="media">
          <%= kamifusen_tag post_l10n.featured_blob %>
        </div>
      <% end %>
    </article>
  <% end %>
</div>