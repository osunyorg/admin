<%= block_component_snippet block, :description %>
<% block.template.communication_file_localizations_published.each do |l10n| %>
  <div class="row mb-4">
    <div class="col-2">
      <% if l10n.featured_blob %>
        <%= kamifusen_tag l10n.featured_blob, width: 200, class: 'img-fluid' %>
      <% else %>
        <div class="osuny__thumbnail osuny__thumbnail--small" style="width: 100%">
          <span class="osuny__thumbnail__icon">
            <i class="<%= l10n.icon %>"></i>
          </span>
        </div>
      <% end %>
    </div>
    <div class="col-10">
      <p class="mb-0"><%= l10n.name %></p>
      <span class="small"><%= l10n.original_filename %></span>
    </div>
  </div>
<% end %>
