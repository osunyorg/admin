<div class="<%= block_html_class(block) %>">
  <div class="container">
    <div class="block-content">
      <%= render 'admin/communication/blocks/partials/top', block: block %>
      <ul class="files">
        <%
        block.template.elements.each do |element|
          file = element.file
          next if file.nil?
          l10n = element.communication_file_l10n
          next unless element.file && l10n
          %>
          <li<% if l10n.featured_blob.present? %> class="with-image"<% end %>>
            <figure>
              <a href="" target="_blank" title="<%= l10n.name %>">
                <%= l10n.name %>
                <figcaption>
                  <abbr title=""><%= l10n.original_extension.sub('.', '').upcase %></abbr>
                  - <abbr title=""><%= number_to_human_size l10n.original_byte_size %></abbr>
                </figcaption>
              </a>
            </figure>
            <% if l10n.featured_blob %>
              <%= kamifusen_tag l10n.featured_blob, width: 300, class: 'img-fluid' %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>