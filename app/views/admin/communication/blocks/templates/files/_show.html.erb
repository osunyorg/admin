<div class="<%= block_html_class(block) %>">
  <div class="container">
    <div class="block-content">
      <%= render 'admin/communication/blocks/partials/top', block: block %>
      <ul class="files">
        <%
        block.template.elements.each do |element|
          file = element.file
          next if file.nil?
          l10n = element.communication_file_l10n
          next unless element.file && l10n
          %>
          <li>
            <figure>
              <a href="<%= l10n.original_blob.url %>" target="_blank" title="<%= l10n.name %>">
                <%= element.title %>
                <figcaption>
                  <abbr title=""><%= l10n.original_extension.sub('.', '').upcase %></abbr>
                  - <abbr title=""><%= number_to_human_size l10n.original_byte_size %></abbr>
                </figcaption>
              </a>
            </figure>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>