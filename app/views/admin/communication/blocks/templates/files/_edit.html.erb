<%= block_component_edit block, :description, summernote_config: 'mini' %>

<div
  v-show="data.elements.length > 1"
  class="mb-3">
  <draggable :list="data.elements" handle=".dragHandle">
    <div v-for="(element, index) in data.elements" class="mb-2">
      <div class="card draggable-item dragHandle m-0">
        <div class="card-body d-flex align-items-center">
          <i class="<%= Icon::MOVE %> handle m-2"></i>
          <p class="mb-0">{{ element.title }}</p>
          <a  class="btn btn-sm text-danger ms-auto"
              @click="deleteElement(element)"
              title="<%= t '.remove_file' %>">
              <i class="<%= Icon::DELETE %>"></i>
          </a>
        </div>
      </div>
    </div>
  </draggable>
</div>

<%= block_component_add_element block, t('.add_file') %>

<div v-for="(element, index) in data.elements" class="pb-5 mb-5">
  <div class="d-flex align-items-center mb-3">
    <file-input
      class="flex-fill"
      :model-value="element.file"
      @update:model-value="element.file = $event; if ($event.communication_file_id) element.title = $event.name"
      upload-url="<%= direct_upload_admin_communication_files_path %>"
      picker-endpoint="<%= picker_admin_communication_files_path(format: :json) %>"
      object-endpoint="<%= admin_communication_files_path %>"
      label="<%= t('admin.communication.blocks.components.file.button') %>"
      title="<%= Communication::File.model_name.human(count: 2) %>"
      accept="*"
      :size-limit="<%= Rails.application.config.default_file_max_size %>">
    </file-input>
    <a
      class="btn btn-sm text-danger ms-3"
      v-if="element.file.communication_file_id"
      @click="element.file = {}"
      title="<%= t('delete') %>">
      <i class="<%= Icon::DELETE %>"></i>
    </a>
  </div>
  <div class="row" v-if="element.file.communication_file_id">  
    <div class="col-md-8">
      <%= block_component_edit block, :title, template: @element %>
    </div>
    <div class="col-md-4">
      <upload-input
        v-model="element.image"
        label="<%= t('admin.communication.blocks.templates.files.edit.element.image.label') %>"
        remove="<%= t('admin.communication.blocks.components.image.input.remove') %>"
        hint="<%= j images_formats_accepted_hint %>"
        accept="<%= default_images_formats_accepted %>"
        :size-limit="<%= Rails.application.config.default_image_max_size %>">
      </upload-input>
    </div>
  </div>
</div>

<div v-if="data.elements.length > 1">
  <%= block_component_add_element block, t('.add_file') %>
</div>