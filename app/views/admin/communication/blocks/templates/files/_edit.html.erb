<%
picker_endpoint = picker_admin_communication_files_path(format: :json)
object_endpoint = admin_communication_files_path
%>

<%= block_component_edit block, :description, summernote_config: 'mini' %>

<draggable
  :list="data.elements"
  handle=".osuny__thumbnail"
  class="row g-2 mb-4">
  <div
    v-for="(element, index) in data.elements"
    class="d-flex align-items-center">
    <selected-file
      :id="element.file.communication_file_id"
      endpoint="<%= object_endpoint %>"
      class="flex-fill">
    </selected-file>
    <a  class="btn btn-sm text-danger ms-3"
        @click="deleteElement(element)"
        title="<%= t('delete') %>">
        <i class="<%= Icon::DELETE %>"></i>
    </a>
  </div>
</draggable>

<file-input
  @update:model-value="data.elements.push({ file: { communication_file_id: $event.communication_file_id } })"
  upload-url="<%= direct_upload_admin_communication_files_path %>"
  picker-endpoint="<%= picker_endpoint %>"
  object-endpoint="<%= object_endpoint %>"
  label="<%= t('admin.communication.blocks.components.file.button') %>"
  title="<%= Communication::File.model_name.human(count: 2) %>"
  accept="*"
  :size-limit="<%= Rails.application.config.default_file_max_size %>">
</file-input>
