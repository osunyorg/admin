<%
vue_model = "#{model}.#{property}"
%>
<file-selector
  :model-value="<%= vue_model %>"
  @update:model-value="<%= vue_model %> = $event; if ($event.communication_file_id) <%= model %>.title = $event.name"
  upload-url="<%= direct_upload_admin_communication_files_path %>"
  picker-endpoint="<%= picker_admin_communication_files_path(format: :json) %>"
  :size-limit="<%= Rails.application.config.default_file_max_size %>">
</file-selector>
