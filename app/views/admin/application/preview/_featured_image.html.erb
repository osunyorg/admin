<%
if l10n.featured_blob.present? 
  format = ActiveStorage::Utils.format(l10n.featured_blob)
%>
  <figure class="featured-image image-<%= format %>">
    <%= kamifusen_tag l10n.featured_blob, alt: l10n.featured_media_alt %>
    <% if l10n.featured_media_credit.present? %>
      <figcaption>
        <div class="credit">
          <%= sanitize l10n.featured_media_credit %>
        </div>
      </figcaption>
    <% end %>
  </figure>
<% end %>