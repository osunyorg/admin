<%
if l10n.featured_blob.present?
  blob = l10n.featured_blob
%>
  <figure class="featured-image image-<%= blob.format %>">
    <%= kamifusen_tag blob, alt: l10n.featured_media_alt %>
    <% if l10n.featured_media_credit.present? %>
      <figcaption>
        <div class="credit">
          <%= sanitize l10n.featured_media_credit %>
        </div>
      </figcaption>
    <% end %>
  </figure>
<% end %>