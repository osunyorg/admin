<div class="row">
  <div class="col-xl-6">
    <div class="alert alert-warning mb-4">
      <div class="alert-message">
        <%= synchronization_locked_by_label(website.synchronization_locked_by) %>
        <% if can?(:unlock_synchronization, website) %>
          <br>
          <%= link_to t('admin.communication.website.synchronization_unlock'),
                      unlock_synchronization_admin_communication_website_path(website, website_id: nil),
                      method: :post,
                      class: 'alert-link' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
