<%
Server::Evolution.planned.each do |evolution|
  song = Osuny::Evolution::Song.random
  l10n = evolution.localizations.find_by(language: current_language)
  %>
  <div class="osuny_evolution">
    <div class="container-fluid">
      <div class="osuny_evolution__text">
        <p class="osuny_evolution__text__title"><%= l10n.title %></p>
        <p class="osuny_evolution__text__text"><%= l10n.text %></p>
      </div>
      <div class="osuny_evolution__date">
        <%= l evolution.released_at, format: "%d·%m" %>
      </div>
      <div class="osuny_evolution__song">
        <p class="osuny_evolution__song__title"><%= song['title'] %></p>
        <p class="osuny_evolution__song__by"><%= song['by'] %></p>
        <div class="osuny_evolution__song__listen">
          Écouter sur
          <ul>
            <% song['listen'].each do |key, value| %>
              <li><%= link_to key, value, target: :_blank %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>