<%
Server::Evolution.planned.each do |evolution|
  l10n = evolution.localizations.find_by(language: current_language) %>
  <div class="osuny_evolution">
    <div class="container-fluid">
      <div class="osuny_evolution__text">
        <p class="osuny_evolution__text__title"><%= l10n.title %></p>
        <p class="osuny_evolution__text__text"><%= l10n.text %></p>
      </div>
      <div class="osuny_evolution__date">
        <%= l evolution.released_at, format: "%d·%m" %>
      </div>
    </div>
  </div>
<% end %>