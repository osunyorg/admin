<div class="row g-3">
  <% organizations.each do |organization| %>
    <div class="col-6 col-lg-3 col-xxl-2">
      <%
      partial = organization.deleted? ? 'admin/university/organizations/organization_deleted'
                                      : 'admin/university/organizations/organization'
      %>
      <%= render partial, organization: organization %>
    </div>
  <% end %>
</div>