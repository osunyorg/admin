<%
university = University.find_by(id: @about.university_id)
blob = @about
base_url = university&.url || ""
%>
<%= raw({
  "name" => blob.filename.to_s,
  "size" => blob.byte_size,
  "width" => blob.width,
  "height" => blob.height,
  "ratio" => blob.ratio,
  "format" => blob.orientation,
  "url" => "#{base_url}#{medium_path(signed_id: blob.signed_id, filename_with_transformations: blob.filename)}",
  "direct_url" => blob.url,
  "download_url" => "#{base_url}#{download_medium_path(signed_id: blob.signed_id)}"
}.compact.to_yaml) %>
